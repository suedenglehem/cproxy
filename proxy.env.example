# cproxy configuration — copy to proxy.env and edit.
# Plain KEY=VALUE lines; # starts a comment. Loaded by start-proxy.cmd.

# Where your OpenAI-compatible LLM server lives (llama-server, Ollama, vLLM, ...)
UPSTREAM=http://localhost:8080/v1

# Optional overrides — defaults shown in comments
PORT=8787
HOST=127.0.0.1
# UPSTREAM_MODEL=qwen3.8-27b   ; force this model id upstream regardless of ANTHROPIC_MODEL
# STRIP_TOOLS=1                ; drop tools from requests (server without function calling)
# LOG=0                        ; silence request logging
# UPSTREAM_KEY=llama           ; Bearer token for the upstream server
